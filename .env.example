# ---- WhatsApp Cloud API (Meta) ----
# Idéalement un System User Token permanent (ne jamais committer le vrai token).
WHATSAPP_TOKEN=EAA...votre_token
PHONE_NUMBER_ID=1346564961870161
# Version de l'API Graph (optionnel)
GRAPH_VERSION=v26.0

# ---- Numéros ADMIN (reçoivent la vérité technique) ----
# Format international sans '+', séparés par des virgules.
ADMIN_NUMBERS=237696995879,237650546186,237693515464

# ---- Sécurité API ----
# Protège tous les endpoints /api/* (header x-admin-token).
ADMIN_API_TOKEN=changez-moi-secret-long

# ---- Monitoring (optionnels) ----
CRITICAL_CONTAINERS=camille,n8n,supabase-db
STEAL_MAX=40
RAM_MAX=92
DISK_MAX=88
COOLDOWN_SEC=900
MONITOR_INTERVAL_SEC=30

# IP publique du serveur (sinon les connexions vers cette IP peuvent être vues comme sortantes).
SERVER_PUBLIC_IP=

# Préfixes IP supplémentaires à ignorer pour la détection C2 (ex. CDN de confiance).
EXTRA_ALLOWED_PREFIXES=

# ---- Templates WhatsApp de secours (hors fenêtre 24h) ----
# Noms de templates APPROUVÉS dans Meta Business Manager.
ADMIN_ALERT_TEMPLATE=
CLIENT_MSG_TEMPLATE=
TEMPLATE_LANG=fr

# ---- Notice AUTO clients ----
# 0 = désactivé. Sinon délai (min) avant l'envoi auto d'un message "incident" aux clients.
AUTO_CLIENT_NOTICE_MIN=0

# ---- Protection facturation (anti-rafale) ----
MAX_MSG_PER_DAY=30            # plafond global journalier (arrêt des envois au-delà)
MAX_MSG_PER_HOUR=6           # coupe-circuit : au-delà, suspension 1h + 1 seul avertissement
CLIENT_BROADCAST_COOLDOWN=3600  # délai min entre deux broadcasts clients (s)
QUIET_HOURS=                 # ex. "23-6" ; vide = désactivé (regroupe les alertes non critiques la nuit)

# ---- Stockage ----
DATA_DIR=/data
PORT=3000
